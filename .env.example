# Local setup requires only this access key and an Upstox read-only token.
TRADEPRISM_USERS={"bib":"REPLACE_WITH_A_RANDOM_KEY_AT_LEAST_24_CHARACTERS"}
UPSTOX_ACCESS_TOKEN=
# Optional Docker deployment only; not required by start.bat / SQLite.
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_DATABASE_PASSWORD

# Start the live feed, stock discovery, candle collector and automatic training.
CONTINUOUS_RESEARCH=1
